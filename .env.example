# SIEM Lite — Environment Configuration
# Copy this to .env and fill in your values
# Never commit .env to version control

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://siem:siempass@localhost:5432/siemdb

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Automation: IP Blocking ───────────────────────────────────────────────────
# Set to "false" in production to enable real iptables blocking
IPTABLES_DRY_RUN=true
# Auto-unblock after N minutes (0 = never)
AUTO_UNBLOCK_MINUTES=60

# ── Automation: Slack Notifications ──────────────────────────────────────────
# Get from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ── Automation: Email Notifications ──────────────────────────────────────────
ALERT_EMAIL=security@yourcompany.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# Use an App Password, not your real password
SMTP_PASS=

# ── Automation: Jira Integration (optional) ───────────────────────────────────
JIRA_URL=https://yourorg.atlassian.net
JIRA_USER=your-email@yourorg.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SEC

# ── Automation: GitHub Issues (optional) ──────────────────────────────────────
GITHUB_TOKEN=
# Format: org/repo e.g. myorg/siem-incidents
GITHUB_REPO=

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Dashboard ─────────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000
